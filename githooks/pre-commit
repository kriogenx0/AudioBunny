#!/bin/bash
# Runs the macOS test suite (build + unit tests — fast, seconds) before
# allowing every commit. Does NOT run the launch stress test (slow,
# relaunches the app repeatedly); that's a manual `make test-stress` for
# specifically chasing a startup/scanning crash.
#
# Activated via: git config core.hooksPath githooks

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if ! make test; then
    echo ""
    echo "✗ Commit blocked: 'make test' failed. Fix the failures above, or use"
    echo "  'git commit --no-verify' to bypass this check (not recommended)."
    exit 1
fi
